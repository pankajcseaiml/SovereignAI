# ========================================================
# SovereignAI — Enterprise Git Ignore Rules
# Strict Zero Secret & Zero Unverified Asset Policy
# ========================================================

# Environments & Secret Storage (STRICTLY FORBIDDEN FROM GIT)
.env
.env.*
!.env.example
*.kdbx
*.enc
*.key
*.pem
*.pfx
*.p12
rclone.conf

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
backend/venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.npm/

# Backups & Raw Dumps
backups/
!backups/.gitkeep
*.dump
*.sql.gz
*.tar.gz
*.bundle

# Storage (preserve folders via .gitkeep)
storage/uploads/*
!storage/uploads/.gitkeep
storage/processed/*
!storage/processed/.gitkeep
storage/generated/*
!storage/generated/.gitkeep
storage/temporary/*
!storage/temporary/.gitkeep
storage/quarantine/*
!storage/quarantine/.gitkeep

# IDEs & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
