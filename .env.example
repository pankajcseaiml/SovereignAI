# ========================================================
# SovereignAI — Environment Configuration Template
# Strictly DO NOT put actual production secrets in this file.
# Copy this file to .env and configure your local environment.
# ========================================================

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@postgres:5432/sovereignai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sovereignai
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis Cache & Celery Broker
REDIS_URL=redis://redis:6379/0

# Microservice URLs & Storage
AI_ENGINE_URL=http://ai-engine:9000
MODEL_SERVER_URL=http://ollama:11434
STORAGE_PATH=/storage

# Security & Tokens
JWT_SECRET=supersecretkey_change_in_production

# Backup & Disaster Recovery (AES-256 32-byte hex key, 64 chars)
# Generated automatically by scripts/keepass_manager.py
BACKUP_ENCRYPTION_KEY=
